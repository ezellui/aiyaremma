+// Вспомогательная функция для оценки времени генерации
+function calculateEstimatedTime(conceptCount, params) {
+  // Базовое время в секундах
+  let baseTime = 30 + (conceptCount * 5);
+  
+  // Время на анализ тезисов и поиск противоречий
+  baseTime += Math.pow(conceptCount, 1.5) * 2;
+  
+  // Время на вызов Claude API (обычно занимает 10-20 секунд)
+  baseTime += 15;
+  
+  // Дополнительное время на обработку сложных параметров
+  if (params) {
+    if (params.additionalRequirements && params.additionalRequirements.length > 100) {
+      baseTime += 10;
+    }
+    
+    if (params.synthesisApproach === 'dialectical' || params.synthesisApproach === 'integrative') {
+      baseTime += 10; // Эти подходы требуют более сложного анализа
+    }
+  }
+  
+  return Math.round(baseTime);
+}
+
+// Функция для валидации и нормализации параметров генерации
+function validateGenerationParams(params) {
+  const validatedParams = { ...params };
+  
+  // Валидация допустимых подходов к синтезу
+  const validApproaches = ['dialectical', 'pragmatic', 'integrative', 'revolutionary'];
+  if (validatedParams.synthesisApproach && !validApproaches.includes(validatedParams.synthesisApproach)) {
+    validatedParams.synthesisApproach = 'integrative'; // Значение по умолчанию
+  }
+  
+  // Валидация списка фокусных тем
+  if (validatedParams.focusTopics && !Array.isArray(validatedParams.focusTopics)) {
+    try {
+      validatedParams.focusTopics = JSON.parse(validatedParams.focusTopics);
+    } catch {
+      validatedParams.focusTopics = [];
+    }
+  }
+  
+  // Валидация температуры для Claude API
+  if (validatedParams.temperature !== undefined) {
+    const temp = parseFloat(validatedParams.temperature);
+    if (isNaN(temp) || temp < 0 || temp > 1) {
+      validatedParams.temperature = 0.7; // Значение по умолчанию
+    } else {
+      validatedParams.temperature = temp;
+    }
+  }
+  
+  // Санитизация текстовых полей
+  if (validatedParams.additionalRequirements) {
+    validatedParams.additionalRequirements = sanitizeText(validatedParams.additionalRequirements, 1000);
+  }
+  
+  if (validatedParams.style) {
+    validatedParams.style = sanitizeText(validatedParams.style, 500);
+  }
+  
+  return validatedParams;
+}
+
+// Функция для санитизации текстовых полей
+function sanitizeText(text, maxLength = 1000) {
+  if (!text) return '';
+  
+  // Преобразуем в строку
+  let sanitized = String(text);
+  
+  // Удаляем потенциально опасные символы или теги
+  sanitized = sanitized.replace(/<script[^>]*>.*?<\/script>/gi, '')
+    .replace(/<[\/\!]*?[^<>]*?>/gi, '')
+    .replace(/<style[^>]*>.*?<\/style>/gi, '')
+    .replace(/<![\s\S]*?--[ \t\n\r]*>/gi, '');
+  
+  // Обрезаем до максимальной длины
+  return sanitized.substring(0, maxLength);
+}
 
 // Алгоритм генерации новой концепции
 async function generateCombinedConcept(requestId) {
