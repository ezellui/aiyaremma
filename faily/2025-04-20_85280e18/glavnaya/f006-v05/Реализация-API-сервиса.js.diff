+// Функция для создания связей между концепциями
+async function createConceptRelations(childId, parentIds) {
+  // Создаем записи о связях в отдельной коллекции
+  const ConceptRelation = mongoose.model('ConceptRelation', new mongoose.Schema({
+    parentId: String,
+    childId: String,
+    relationType: { type: String, default: 'derived' },
+    createdAt: { type: Date, default: Date.now }
+  }));
+  
+  // Создаем связи с каждым родителем
+  const relations = parentIds.map(parentId => ({
+    parentId,
+    childId,
+    relationType: 'derived'
+  }));
+  
+  await ConceptRelation.insertMany(relations);
+}
