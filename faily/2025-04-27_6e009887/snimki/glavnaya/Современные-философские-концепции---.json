  ],
  "categories": [
    {
      "id": "cat_ex_1",
      "conceptId": "concept_existentialism",
      "name": "Экзистенция",
      "definition": "Способ бытия человека, характеризующийся осознанием своей конечности и свободы",
      "source": "Бытие и время, Бытие и ничто",
      "traditions": ["экзистенциализм", "феноменология"],
      "philosophers": ["Хайдеггер", "Сартр", "Ясперс"],
      "metrics": {
        "centrality": 10,
        "definition": 8,
        "historical": 9
      }
    },
    {
      "id": "cat_ex_2",
      "conceptId": "concept_existentialism",
      "name": "Свобода",
      "definition": "Фундаментальная характеристика человеческого бытия, основа выбора и ответственности",
      "source": "Бытие и ничто, Экзистенциализм - это гуманизм",
      "traditions": ["экзистенциализм", "персонализм"],
      "philosophers": ["Сартр", "Камю", "Бердяев"],
      "metrics": {
        "centrality": 10,
        "definition": 9,
        "historical": 10
      }
    },
    {
      "id": "cat_ex_3",
      "conceptId": "concept_existentialism",
      "name": "Абсурд",
      "definition": "Конфликт между человеческим стремлением к смыслу и безмолвием мира",
      "source": "Миф о Сизифе",
      "traditions": ["экзистенциализм", "абсурдизм"],
      "philosophers": ["Камю", "Сартр", "Кьеркегор"],
      "metrics": {
        "centrality": 8,
        "definition": 9,
        "historical": 8
      }
    },
    {
      "id": "cat_ex_4",
      "conceptId": "concept_existentialism",
      "name": "Тревога",
      "definition": "Фундаментальное настроение, раскрывающее конечность и свободу человека",
      "source": "Понятие страха, Бытие и время",
      "traditions": ["экзистенциализм", "психоанализ"],
      "philosophers": ["Кьеркегор", "Хайдеггер", "Тиллих"],
      "metrics": {
        "centrality": 9,
        "definition": 8,
        "historical": 9
      }
    },
    {
      "id": "cat_phen_1",
      "conceptId": "concept_phenomenology",
      "name": "Интенциональность",
      "definition": "Направленность сознания на предмет, фундаментальная структура опыта",
      "source": "Логические исследования, Идеи I",
      "traditions": ["феноменология", "философия сознания"],
      "philosophers": ["Гуссерль", "Брентано", "Мерло-Понти"],
      "metrics": {
        "centrality": 10,
        "definition": 9,
        "historical": 10
      }
    },
    {
      "id": "cat_phen_2",
      "conceptId": "concept_phenomenology",
      "name": "Эпохе",
      "definition": "Феноменологическая редукция, воздержание от суждений о существовании мира",
      "source": "Идеи к чистой феноменологии",
      "traditions": ["феноменология", "трансцендентализм"],
      "philosophers": ["Гуссерль", "Финк", "Ингарден"],
      "metrics": {
        "centrality": 9,
        "definition": 8,
        "historical": 9
      }
    },
    {
      "id": "cat_phen_3",
      "conceptId": "concept_phenomenology",
      "name": "Жизненный мир",
      "definition": "Дорефлексивный горизонт всякого опыта, мир повседневности",
      "source": "Кризис европейских наук",
      "traditions": ["феноменология", "герменевтика"],
      "philosophers": ["Гуссерль", "Шюц", "Хабермас"],
      "metrics": {
        "centrality": 9,
        "definition": 8,
        "historical": 9
      }
    },
    {
      "id": "cat_phen_4",
      "conceptId": "concept_phenomenology",
      "name": "Горизонт",
      "definition": "Неявный фон восприятия, обеспечивающий контекст понимания",
      "source": "Идеи I, Картезианские размышления",
      "traditions": ["феноменология", "герменевтика"],
      "philosophers": ["Гуссерль", "Гадамер", "Мерло-Понти"],
      "metrics": {
        "centrality": 8,
        "definition": 7,
        "historical": 8
      }
    },
    {
      "id": "cat_post_1",
      "conceptId": "concept_poststructuralism",
      "name": "Деконструкция",
      "definition": "Метод анализа текстов через выявление внутренних противоречий и скрытых предпосылок",
      "source": "О грамматологии",
      "traditions": ["постструктурализм", "деконструктивизм"],
      "philosophers": ["Деррида", "де Ман", "Миллер"],
      "metrics": {
        "centrality": 10,
        "definition": 8,
        "historical": 9
      }
    },
    {
      "id": "cat_post_2",
      "conceptId": "concept_poststructuralism",
      "name": "Различание (différance)",
      "definition": "Процесс одновременного различения и откладывания смысла во времени",
      "source": "Письмо и различие",
      "traditions": ["постструктурализм", "семиотика"],
      "philosophers": ["Деррида", "Кристева", "Барт"],
      "metrics": {
        "centrality": 9,
        "definition": 7,
        "historical": 8
      }
    },
    {
      "id": "cat_post_3",
      "conceptId": "concept_poststructuralism",
      "name": "Власть-знание",
      "definition": "Неразрывная связь между структурами власти и производством знания",
      "source": "Надзирать и наказывать, Археология знания",
      "traditions": ["постструктурализм", "постмодернизм"],
      "philosophers": ["Фуко", "Делёз", "Агамбен"],
      "metrics": {
        "centrality": 9,
        "definition": 9,
        "historical": 10
      }
    },
    {
      "id": "cat_post_4",
      "conceptId": "concept_poststructuralism",
      "name": "Ризома",
      "definition": "Нелинейная, множественная структура мышления и бытия без центра и иерархии",
      "source": "Тысяча плато",
      "traditions": ["постструктурализм", "постмодернизм"],
      "philosophers": ["Делёз", "Гваттари"],
      "metrics": {
        "centrality": 8,
        "definition": 7,
        "historical": 8
      }
    }
  ],
