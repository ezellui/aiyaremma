
graph TD
    %% Определение узлов графа
    %% Центральное понятие
    FR["Философская рефлексия"]
    
    %% Сущностные понятия метафилософии
    PF["Природа философии"]
    MP["Методология философии"]
    GPZ["Границы философского знания"]
    KFI["Критерии философской истины"]
    IF["Историчность философии"]
    DIS["Диалектика изучения и создания"]
    
    %% Вторичные понятия
    LF["Легитимация философии"]
    GFT["Герменевтика философских текстов"]
    FT["Философская традиция"]
    FTV["Философское творчество"]
    KA["Концептуальный аппарат"]
    FA["Философский аргумент"]
    OP["Онтологические предпосылки"]
    EO["Эпистемологические основания"]
    
    %% Периферийные понятия
    FI["Философская интуиция"]
    FPR["Философская практика"]
    IDF["Идентичность философа"]
    FPG["Философский прогресс"]
    
    %% Определение связей и их типов
    
    %% 1. Конституирование - определяет сущностные характеристики
    FR -- "Конституирует" --> PF
    FR -- "Конституирует" --> MP
    FR -- "Конституирует" --> GPZ
    FR -- "Конституирует" --> KFI
    
    %% 2. Диалектическое единство - противоположности, образующие целое
    IF <-- "Диалектическое единство" --> DIS
    PF <-- "Диалектическое единство" --> OP
    MP <-- "Диалектическое единство" --> EO
    FT <-- "Диалектическое единство" --> FTV
    
    %% 3. Герменевтическое отношение - интерпретирует, осмысляет
    GFT -- "Интерпретирует" --> IF
    IF -- "Обогащает" --> GFT
    GFT -- "Интерпретирует" --> FT
    
    %% 4. Методологическое обоснование - обеспечивает инструментами познания
    MP -- "Обосновывает" --> KA
    KA -- "Обосновывает" --> FA
    KFI -- "Верифицирует" --> FA
    FA -- "Реализует" --> KFI
    
    %% 5. Историческая преемственность - обеспечивает развитие во времени
    IF -- "Определяет" --> PF
    IF -- "Формирует" --> FT
    FT -- "Обогащает" --> IF
    IF -- "Формирует" --> IDF
    IF -- "Обеспечивает" --> FPG
    
    %% 6. Трансценденция - выход за пределы, преодоление границ
    GPZ -- "Трансцендирует" --> FR
    MP -- "Реализуется в" --> FPR
    LF -- "Питается" --> FI
    DIS -- "Обеспечивает" --> FPG
    
    %% 7. Легитимация - обоснование права на существование
    LF -- "Легитимирует" --> GPZ
    LF -- "Обосновывает" --> PF
    LF -- "Легитимирует" --> PF
    
    %% 8. Феноменологическая редукция - выявление сущностного
    FR -- "Редуцирует к" --> DIS
    FTV -- "Питает" --> FR

    %% Стили узлов для группировки по категориям
    classDef central fill:#e0f7fa,stroke:#00838f,stroke-width:2px;
    classDef essential fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px;
    classDef secondary fill:#fff8e1,stroke:#ff8f00,stroke-width:2px;
    classDef peripheral fill:#ffebee,stroke:#c62828,stroke-width:2px;

    %% Применение стилей к узлам
    class FR central;
    class PF,MP,GPZ,KFI,IF,DIS essential;
    class LF,GFT,FT,FTV,KA,FA,OP,EO secondary;
    class FI,FPR,IDF,FPG peripheral;
