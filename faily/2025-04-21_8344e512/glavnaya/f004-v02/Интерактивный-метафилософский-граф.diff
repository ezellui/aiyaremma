+    // Обновление позиций при тике симуляции
+    function ticked() {
+      link.attr("d", d => {
+        const dx = d.target.x - d.source.x;
+        const dy = d.target.y - d.source.y;
+        const dr = Math.sqrt(dx * dx + dy * dy);
+        
+        // Для самореференционных связей (петли)
+        if (d.source === d.target) {
+          const dr = 30;
+          return `M${d.source.x},${d.source.y} A${dr},${dr} 0 1,1 ${d.source.x + 1},${d.source.y + 1}`;
+        }
+        
+        return `M${d.source.x},${d.source.y} L${d.target.x},${d.target.y}`;
+      });
+      
+      linkLabels.attr("transform", d => {
+        if (d.source === d.target) {
+          // Для петель размещаем метку над петлей
+          return `translate(${d.source.x + 20},${d.source.y - 20})`;
+        }
+        
+        // Для обычных связей — посередине линии
+        const mid_x = (d.source.x + d.target.x) / 2;
+        const mid_y = (d.source.y + d.target.y) / 2;
+        
+        return `translate(${mid_x},${mid_y - 5})`;
+      });
+      
+      node.attr("transform", d => `translate(${d.x},${d.y})`);
+    }
