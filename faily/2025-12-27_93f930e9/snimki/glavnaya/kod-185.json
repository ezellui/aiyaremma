{
  "name": "@philos/concept-service",
  "version": "1.0.0",
  "description": "Concept management service for philosophy concept platform",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "validate": "npm run lint && npm run test"
  },
  "keywords": ["concepts", "philosophy", "neo4j"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@philos/shared": "file:../shared",
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "mongodb": "^6.3.0",
    "neo4j-driver": "^5.15.0",
    "uuid": "^9.0.1",
    "joi": "^17.11.0",
    "axios": "^1.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1"
  }
}