
flowchart LR
    title[<b>Прогрессии целотоновых трезвучий в структуре</b>]
    
    %% Секция для первых 6 рядов
    subgraph "Нижний регистр (B1-E4)"
        %% Ряд 1
        B1(("B1"))
        Db2(("Db2"))
        Eb2(("Eb2"))
        
        %% Ряд 2
        E2(("E2"))
        Gb2(("Gb2"))
        Ab2(("Ab2"))
        
        %% Ряд 3
        A2(("A2"))
        B2(("B2"))
        Db3(("Db3"))
        
        %% Ряд 4
        D3(("D3"))
        E3(("E3"))
        Gb3(("Gb3"))
        
        %% Ряд 5
        G3(("G3"))
        A3(("A3"))
        B3(("B3"))
        
        %% Ряд 6
        C4(("C4"))
        D4(("D4"))
        E4(("E4"))
        
        %% Целотоновые связи внутри строк
        B1 --- Db2 --- Eb2
        E2 --- Gb2 --- Ab2
        A2 --- B2 --- Db3
        D3 --- E3 --- Gb3
        G3 --- A3 --- B3
        C4 --- D4 --- E4
        
        %% Квартовые связи между строками
        B1 -. "P4" .-> E2
        E2 -. "P4" .-> A2
        A2 -. "P4" .-> D3
        D3 -. "P4" .-> G3
        G3 -. "P4" .-> C4
    end
    
    %% Секция для последующих 6 рядов
    subgraph "Верхний регистр (F4-Bb6)"
        %% Ряд 7
        F4(("F4"))
        G4(("G4"))
        A4(("A4"))
        
        %% Ряд 8
        Bb4(("Bb4"))
        C5(("C5"))
        D5(("D5"))
        
        %% Ряд 9
        Eb5(("Eb5"))
        F5(("F5"))
        G5(("G5"))
        
        %% Ряд 10
        Ab5(("Ab5"))
        Bb5(("Bb5"))
        C6(("C6"))
        
        %% Ряд 11
        Db6(("Db6"))
        Eb6(("Eb6"))
        F6(("F6"))
        
        %% Ряд 12
        Gb6(("Gb6"))
        Ab6(("Ab6"))
        Bb6(("Bb6"))
        
        %% Целотоновые связи внутри строк
        F4 --- G4 --- A4
        Bb4 --- C5 --- D5
        Eb5 --- F5 --- G5
        Ab5 --- Bb5 --- C6
        Db6 --- Eb6 --- F6
        Gb6 --- Ab6 --- Bb6
        
        %% Квартовые связи между строками
        C4 -. "P4" .-> F4
        F4 -. "P4" .-> Bb4
        Bb4 -. "P4" .-> Eb5
        Eb5 -. "P4" .-> Ab5
        Ab5 -. "P4" .-> Db6
        Db6 -. "P4" .-> Gb6
    end
    
    %% Связь между секциями (закрывающая круг)
    Gb6 -. "P4" .-> B1
    
    %% Информационные блоки - теоретические интерпретации
    WholeTone["Целотоновая структура:<br>Интервал в 2 полутона между соседними нотами в строке"]
    FourthCycle["Цикл кварт:<br>Подъем на квартовый интервал (5 полутонов) между строками"]
    ForteSets["Теория множеств:<br>Каждая строка представляет множество класса [0,2,4]<br>(№3-6 по Аллену Форте)"]
    
    %% Соединение информационных блоков
    title --- WholeTone
    title --- FourthCycle
    title --- ForteSets
    
    %% Стили для нот и секций
    classDef default fill:#f9f9f9,stroke:#333,stroke-width:1px
    classDef titleClass fill:#e6f2ff,stroke:#333,stroke-width:2px,font-size:16px
    classDef infoClass fill:#fffaf0,stroke:#333,stroke-width:1px
    
    %% Цветовая схема для рядов
    classDef row1 fill:#e6194B,color:white,stroke:#333
    classDef row2 fill:#3cb44b,color:white,stroke:#333
    classDef row3 fill:#ffe119,color:black,stroke:#333
    classDef row4 fill:#4363d8,color:white,stroke:#333
    classDef row5 fill:#f58231,color:white,stroke:#333
    classDef row6 fill:#911eb4,color:white,stroke:#333
    classDef row7 fill:#42d4f4,color:black,stroke:#333
    classDef row8 fill:#f032e6,color:white,stroke:#333
    classDef row9 fill:#a9a9a9,color:white,stroke:#333
    classDef row10 fill:#469990,color:white,stroke:#333
    classDef row11 fill:#e6beff,color:black,stroke:#333
    classDef row12 fill:#9A6324,color:white,stroke:#333
    
    %% Применение стилей
    class title titleClass
    class WholeTone,FourthCycle,ForteSets infoClass
    
    %% Стили для рядов нот
    class B1,Db2,Eb2 row1
    class E2,Gb2,Ab2 row2
    class A2,B2,Db3 row3
    class D3,E3,Gb3 row4
    class G3,A3,B3 row5
    class C4,D4,E4 row6
    class F4,G4,A4 row7
    class Bb4,C5,D5 row8
    class Eb5,F5,G5 row9
    class Ab5,Bb5,C6 row10
    class Db6,Eb6,F6 row11
    class Gb6,Ab6,Bb6 row12
