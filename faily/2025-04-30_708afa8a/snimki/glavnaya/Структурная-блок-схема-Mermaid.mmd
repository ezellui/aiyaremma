
flowchart TD
    title[<b>Структурная схема музыкальной системы</b>]
    
    %% Первый уровень - разделение на строки
    Start[12-тоновая система]
    
    %% Деление на 12 строк
    Row1[Ряд 1: B1 - Db2 - Eb2]
    Row2[Ряд 2: E2 - Gb2 - Ab2]
    Row3[Ряд 3: A2 - B2 - Db3]
    Row4[Ряд 4: D3 - E3 - Gb3]
    Row5[Ряд 5: G3 - A3 - B3]
    Row6[Ряд 6: C4 - D4 - E4]
    Row7[Ряд 7: F4 - G4 - A4]
    Row8[Ряд 8: Bb4 - C5 - D5]
    Row9[Ряд 9: Eb5 - F5 - G5]
    Row10[Ряд 10: Ab5 - Bb5 - C6]
    Row11[Ряд 11: Db6 - Eb6 - F6]
    Row12[Ряд 12: Gb6 - Ab6 - Bb6]
    
    %% Связи первого уровня
    Start --> Row1 & Row2 & Row3 & Row4 & Row5 & Row6 & Row7 & Row8 & Row9 & Row10 & Row11 & Row12
    
    %% Интервальная структура
    Int1[<b>Внутри строк:</b><br>целотоновые интервалы<br>(2 полутона)]
    Int2[<b>Между строками:</b><br>квартовые интервалы<br>(5 полутонов)]
    
    Int1 -.-> Row1
    Int2 -.-> Row1
    
    %% Вертикальные гармонические отношения
    subgraph "Вертикальные гармонические отношения"
        C["C-структура<br>(C4, G3, D3, A2, E2, B1)"]
        Db["Db-структура<br>(Db6, Ab5, Eb5, Bb4, F4, C4)"]
        D["D-структура<br>(D5, A4, E4, B3, F#3, C#3)"]
    end
    
    %% Горизонтальные гармонические отношения
    subgraph "Горизонтальные гармонические отношения"
        W1["Целотонная шкала 1<br>(C, D, E, F#, G#, A#)"]
        W2["Целотонная шкала 2<br>(C#, D#, F, G, A, B)"]
    end
    
    %% Теоретические связи
    subgraph "Теоретические связи"
        Clock["Тоновые часы<br>(Петер Схат)"]
        PCS["Теория множеств<br>высотных классов"]
        Quart["Квартовая<br>гармония"]
        Sym["Симметричные<br>структуры"]
    end
    
    %% Связывание с теоретическими концепциями
    Row1 & Row12 -.-> Clock
    Row1 & Row2 & Row3 & Row4 & Row5 & Row6 -.-> PCS
    Row7 & Row8 & Row9 & Row10 & Row11 & Row12 -.-> Quart
    Row1 & Row6 & Row12 -.-> Sym
    
    %% Стили
    classDef default fill:#f9f9f9,stroke:#333,stroke-width:1px
    classDef heading fill:#e6f2ff,stroke:#333,stroke-width:2px
    classDef row1 fill:#e6194B,color:white,stroke:#333
    classDef row2 fill:#3cb44b,color:white,stroke:#333
    classDef row3 fill:#ffe119,color:black,stroke:#333
    classDef row4 fill:#4363d8,color:white,stroke:#333
    classDef row5 fill:#f58231,color:white,stroke:#333
    classDef row6 fill:#911eb4,color:white,stroke:#333
    classDef row7 fill:#42d4f4,color:black,stroke:#333
    classDef row8 fill:#f032e6,color:white,stroke:#333
    classDef row9 fill:#a9a9a9,color:white,stroke:#333
    classDef row10 fill:#469990,color:white,stroke:#333
    classDef row11 fill:#e6beff,color:black,stroke:#333
    classDef row12 fill:#9A6324,color:white,stroke:#333
    classDef intervalClass fill:#f0f8ff,stroke:#333,stroke-width:1px
    classDef theoryClass fill:#fffaf0,stroke:#333,stroke-width:1px
    
    class title,Start heading
    class Row1 row1
    class Row2 row2
    class Row3 row3
    class Row4 row4
    class Row5 row5
    class Row6 row6
    class Row7 row7
    class Row8 row8
    class Row9 row9
    class Row10 row10
    class Row11 row11
    class Row12 row12
    class Int1,Int2 intervalClass
    class C,Db,D,W1,W2 theoryClass
    class Clock,PCS,Quart,Sym theoryClass
