graph TD
    subgraph "Мифологический горизонт сознания"
        A[Мифологическое сознание] --> B[Единство образа и смысла]
        A --> C[Непосредственность переживания]
        A --> D[Целостность восприятия]
        
        B --> E[Символическое мышление]
        C --> E
        D --> E
        
        E --> F[Личностное бытие]
        E --> G[Космическое бытие]
        F <--> G
    end
    
    subgraph "Диалектика имени"
        H[Имя] --> I[Конвенциональный аспект]
        H --> J[Онтологический аспект]
        
        I --> K[Употребление в языковых играх]
        J --> L[Энергийное самораскрытие сущности]
        
        K <-- Диалектическое единство --> L
        
        M[Обыденное словоупотребление] --> N[Критическое осмысление]
        N --> O[Символическое постижение]
        O -.-> M
    end
    
    A --- H
    E --- L
    
    classDef primary fill:#f9d5e5,stroke:#333,stroke-width:3px
    classDef secondary fill:#d5e5f9,stroke:#333,stroke-width:2px
    classDef tertiary fill:#f9e5d5,stroke:#333,stroke-width:2px
    
    class A,H primary
    class B,C,D,I,J secondary
    class E,F,G,K,L,M,N,O tertiary