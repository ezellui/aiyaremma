flowchart TD
    subgraph "Познавательные процессы"
        A[Познание] --> B[Герменевтическая феноменология]
        A --> C[Языковые игры как формы познания]
        A --> D[Диалектика явного и неявного знания]
        
        B --> E[Непосредственное усмотрение]
        B --> F[Истолкование]
        E <--> F
        
        C --> G[Наука]
        C --> H[Искусство]
        C --> I[Религия]
        C --> J[Обыденное познание]
        
        G --- K[Семейное сходство]
        H --- K
        I --- K
        J --- K
        
        D --> L[Эксплицитное знание]
        D --> M[Имплицитное знание]
        L <--> M
    end
    
    subgraph "Диалектическое преодоление субъект-объектной дихотомии"
        N[Познающий] <--> O[Познаваемое]
        
        N --> P[Всегда уже вовлечён в мир]
        O --> Q[Всегда уже содержит условия возможности познания]
        
        P <--> Q
    end
    
    subgraph "Символическое постижение"
        R[Символическое постижение] --> S[Рациональное]
        R --> T[Интуитивное]
        R --> U[Дискурсивное]
        R --> V[Непосредственное]
        
        S <--> T
        U <--> V
        
        W[Аналитическая точность] <--> X[Синтетическая полнота]
        
        S --- W
        T --- X
        U --- W
        V --- X
    end
    
    A --- N
    A --- O
    A --- R
    
    classDef primary fill:#f9d5e5,stroke:#333,stroke-width:3px
    classDef secondary fill:#d5e5f9,stroke:#333,stroke-width:2px
    classDef tertiary fill:#e5f9d5,stroke:#333,stroke-width:2px
    
    class A,N,O,R primary
    class B,C,D,P,Q,S,T,U,V secondary
    class E,F,G,H,I,J,K,L,M,W,X tertiary