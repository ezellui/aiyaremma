flowchart TD
    subgraph "Философия как терапевтическая диалектика"
        A[Философия] --> B[Терапевтическая диалектика]
        
        B --> C[Освобождение от догматических фиксаций]
        B --> D[Преодоление ложных противоположностей]
        B --> E[Возвращение к живым источникам мышления]
    end
    
    subgraph "Диалог как путь к истине"
        F[Диалог] --> G[Онтологическая структура]
        F --> H[Столкновение различных перспектив]
        
        H --> I[Преодоление ограниченности]
        H --> J[Открытость для иного]
        H --> K[Обогащение через встречу]
        
        L[Диалектическая природа бытия] --- G
    end
    
    subgraph "Философия как 'вторая навигация'"
        M["Вторая навигация"] --> N[Наивное принятие языковых игр]
        M --> O[Критическая рефлексия]
        M --> P[Возвращение к конкретности жизни]
        
        N --> O
        O --> P
        P -.-> N
    end
    
    subgraph "Открытость как принцип мышления"
        Q[Открытое мышление] --> R[Строгость понятийного анализа]
        Q --> S[Готовность к встрече с непредвиденным]
        
        R <--> S
        
        T[Истина как событие] --- Q
        
        U[Определённость понятий] <--> V[Неисчерпаемость бытия]
        W[Строгость метода] <--> X[Творческая интуиция]
        
        U --- R
        V --- S
        W --- R
        X --- S
    end
    
    subgraph "Перспективы синтетического мышления"
        Y[Синтетическое мышление] --> Z[Диалог с восточными традициями]
        Y --> AA[Диалог с современными направлениями]
        
        Z --> AB[Даосизм]
        Z --> AC[Буддизм]
        Z --> AD[Адвайта-веданта]
        
        AA --> AE[Экологическая философия]
        AA --> AF[Феминистская теория]
        AA --> AG[Постколониальные исследования]
        
        AH[Обогащение синтеза] --- Z
        AH --- AA
        
        AI[Новые аспекты диалектики бытия-в-языке] --- AH
    end
    
    A --- F
    A --- M
    A --- Q
    A --- Y
    
    classDef primary fill:#f9d5e5,stroke:#333,stroke-width:3px
    classDef secondary fill:#d5e5f9,stroke:#333,stroke-width:2px
    classDef tertiary fill:#e5f9d5,stroke:#333,stroke-width:2px
    classDef quaternary fill:#f9e5d5,stroke:#333,stroke-width:2px
    
    class A,F,M,Q,Y primary
    class B,G,H,N,O,P,R,S,Z,AA secondary
    class C,D,E,I,J,K,T,U,V,W,X,AB,AC,AD,AE,AF,AG tertiary
    class L,AH,AI quaternary