graph TD
    subgraph "Человек как бытие-в-языке-с-другими"
        A[Человек] --> B[Бытие-в-языке-с-другими]
        
        B --> C[Индивидуальность]
        B --> D[Социальность]
        
        C <--> D
        
        E[Языковые игры сообщества] --- C
        F[Свободное самоопределение] --- D
    end
    
    subgraph "Диалектика свободы и необходимости"
        G[Свобода и необходимость] --> H[Брошенность]
        G --> I[Проект]
        
        H <--> I
        
        J[Исторический контекст] --- H
        K[Горизонт возможностей] --- I
        
        L[Преобразование необходимости] --- G
        M[Осознанная необходимость] --- G
    end
    
    subgraph "Аутентичность"
        N[Аутентичность] --> O[Самость]
        N --> P[Инаковость]
        
        O <--> P
        
        Q["Я"] --- O
        R["Ты"] --- P
        S["Мы"] --- P
        
        T[Социальные нормы] --> U[Творческое переосмысление]
        U --> V[Собственные возможности бытия]
    end
    
    subgraph "Этика диалогической ответственности"
        W[Этика] --> X[Диалогическая ответственность]
        
        X --> Y[Признание другого как бытия-в-языке]
        X --> Z[Конкретная ответственность]
        
        AA[Формализм кантианской этики] --> AB[Преодоление]
        AC[Релятивизм] --> AB
        
        AB --> AD[Диалектика особенного и всеобщего]
    end
    
    subgraph "Экзистенциальная диалектика"
        AE[Экзистенциальная диалектика] --> AF[Страх]
        AE --> AG[Надежда]
        AE --> AH[Отчаяние]
        AE --> AI[Вера]
        AE --> AJ[Конечность]
        AE --> AK[Бесконечность]
        
        AF <--> AG
        AH <--> AI
        AJ <--> AK
        
        AL[Антиномичность существования] --- AE
        AM[Мужество быть] --- AE
    end
    
    A --- G
    A --- N
    A --- W
    A --- AE
    N --- X
    
    classDef primary fill:#f9d5e5,stroke:#333,stroke-width:3px
    classDef secondary fill:#d5e5f9,stroke:#333,stroke-width:2px
    classDef tertiary fill:#e5f9d5,stroke:#333,stroke-width:2px
    classDef quaternary fill:#f9e5d5,stroke:#333,stroke-width:2px
    
    class A,G,N,W,AE primary
    class B,H,I,O,P,X,AF,AG,AH,AI,AJ,AK secondary
    class C,D,E,F,J,K,L,M,Q,R,S,Y,Z,AA,AC,AL,AM tertiary
    class T,U,V,AB,AD quaternary