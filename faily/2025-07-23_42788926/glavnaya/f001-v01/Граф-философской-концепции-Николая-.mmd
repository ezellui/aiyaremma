graph TD
    %% Основные онтологические категории
    B[Бытие] --> SB[Слои бытия]
    B --> K[Категории]
    B --> M[Модусы бытия]
    
    %% Четыре слоя бытия
    SB --> NB[Неорганический слой]
    SB --> OB[Органический слой] 
    SB --> DB[Душевный слой]
    SB --> SP[Духовный слой]
    
    %% Отношения между слоями
    NB --> OB
    OB --> DB
    DB --> SP
    
    %% Категории познания и бытия
    K --> KB[Категории бытия]
    K --> KP[Категории познания]
    KB -.->|не тождественны| KP
    
    %% Основные категории бытия
    KB --> SC[Существование]
    KB --> SU[Сущность]
    KB --> KC[Качество]
    KB --> KO[Количество]
    KB --> OT[Отношение]
    KB --> PR[Пространство]
    KB --> VR[Время]
    KB --> KA[Каузальность]
    KB --> V[Взаимодействие]
    KB --> C[Целесообразность]
    
    %% Модальные категории
    M --> R[Реальность]
    M --> VZ[Возможность]
    M --> N[Необходимость]
    M --> SL[Случайность]
    M --> D[Действительность]
    
    %% Отношения определенности/неопределенности
    SU --> OP[Определенность]
    SU --> NO[Неопределенность]
    OP -.->|диалектически связаны| NO
    
    %% Законы слоев
    NB --> ZN[Законы неорганического]
    OB --> ZO[Законы органического]
    DB --> ZD[Законы душевного]
    SP --> ZS[Законы духовного]
    
    %% Принцип основания и зависимости
    PO[Принцип основания] --> ZV[Зависимость]
    PO --> NZ[Независимость]
    ZV -.->|взаимоопределяют| NZ
    
    %% Категории духовного слоя
    SP --> IS[История]
    SP --> KU[Культура]
    SP --> YZ[Язык]
    SP --> PR_SP[Право]
    SP --> MO[Мораль]
    SP --> IS_SP[Искусство]
    SP --> RE[Религия]
    SP --> FI[Философия]
    
    %% Категории душевного слоя
    DB --> PS[Психическое]
    DB --> SO[Сознание]
    DB --> VO[Воля]
    DB --> CH[Чувство]
    DB --> IN[Интенциональность]
    
    %% Категории органического слоя
    OB --> ZH[Жизнь]
    OB --> OR[Организм]
    OB --> CE[Целесообразность органическая]
    OB --> EV[Эволюция]
    OB --> NA[Наследственность]
    
    %% Категории неорганического слоя
    NB --> MA[Материя]
    NB --> EN[Энергия]
    NB --> DV[Движение]
    NB --> GR[Гравитация]
    NB --> AT[Атомность]
    
    %% Гносеологические категории
    KP --> SB_P[Субъект]
    KP --> OB_P[Объект]
    KP --> SO_P[Сознание познающее]
    KP --> IN_P[Интенция]
    KP --> FE[Феномен]
    KP --> NO_P[Ноумен]
    
    %% Проблема познания
    G[Гносеология] --> TP[Трансцендентальная проблема]
    G --> MP[Метафизическая проблема]
    TP -.->|переходит в| MP
    
    %% Отношения онтологии и гносеологии
    ON[Онтология] -->|первична| G
    ON --> B
    
    %% Категориальные отношения в слоях
    ZN -.->|лежат в основе| ZO
    ZO -.->|лежат в основе| ZD  
    ZD -.->|лежат в основе| ZS
    
    %% Принцип новых категорий
    NB -.->|новые категории возникают в| OB
    OB -.->|новые категории возникают в| DB
    DB -.->|новые категории возникают в| SP
    
    %% Ценности
    CE_V[Ценности] --> SP
    CE_V --> ET[Этические ценности]
    CE_V --> ES[Эстетические ценности]
    CE_V --> LO[Логические ценности]
    CE_V --> ME[Метафизические ценности]
    
    %% Свобода и детерминизм
    SW[Свобода] --> DB
    SW --> SP
    DE[Детерминизм] --> NB
    DE --> OB
    SW -.->|проблема соотношения| DE
    
    %% Время и история
    VR --> IS
    IS --> VR_IS[Историческое время]
    VR_IS -.->|отличается от| VR
    
    %% Индивидуальность
    IND[Индивидуальность] --> DB
    IND --> SP
    IND --> OS[Особенность]
    IND --> ED[Единичность]
    
    %% Формы и структуры
    FO[Форма] --> ST[Структура]
    ST --> NB
    ST --> OB
    ST --> DB
    ST --> SP
    
    %% Проблема реальности
    R --> RE_R[Реальное бытие]
    R --> ID[Идеальное бытие]
    RE_R -.->|противопоставляется| ID
    
    %% Категориальные антиномии
    AN[Антиномии] --> OP
    AN --> NO
    AN --> ZV
    AN --> NZ
    AN --> R
    AN --> VZ
    
    %% Самореференция бытия
    B --> B
    K --> K
    ON --> ON