graph LR
    subgraph "КОСМИЧЕСКИЕ ЦИКЛЫ"
        A1[СТАТИС] -->|порождает| B1[устойчивость]
        B1 -->|нарушается| C1[КИНЕСИС]
        C1 -->|порождает| D1[изменение]
        D1 -->|направляется| E1[ТЕЛОС]
        E1 -->|порождает| F1[смысл]
        F1 -->|закрепляется в| A1
    end
    
    subgraph "ЧЕЛОВЕЧЕСКОЕ ИЗМЕРЕНИЕ"
        A2[Самосознание<br/>СТАТИС] <--> B2[Опыт<br/>КИНЕСИС]
        B2 <--> C2[Цель<br/>ТЕЛОС]
        C2 <--> A2
        
        A2 -.-> D2[МУДРОСТЬ]
        B2 -.-> E2[ТВОРЧЕСТВО]
        C2 -.-> F2[ГАРМОНИЯ]
        
        D2 & E2 & F2 --> G2[ЦЕЛОСТНАЯ<br/>ЛИЧНОСТЬ]
    end
    
    subgraph "ПОЗНАВАТЕЛЬНЫЕ МОДУСЫ"
        A3[Созерцание<br/>νόησις] 
        B3[Восприятие<br/>αἴσθησις]
        C3[Понимание<br/>σύνεσις]
        
        A3 -->|открывает| D3[Вечные истины]
        B3 -->|схватывает| E3[Феномены]
        C3 -->|постигает| F3[Смыслы]
        
        D3 & E3 & F3 --> G3[ПОЛНОЕ<br/>ЗНАНИЕ]
    end
    
    style A1 fill:#ff6b6b
    style C1 fill:#4ecdc4
    style E1 fill:#ffe66d
    style A2 fill:#ff6b6b
    style B2 fill:#4ecdc4
    style C2 fill:#ffe66d
    style G2 fill:#95e1d3
    style G3 fill:#95e1d3