graph TD
    subgraph "ТРИ ПЕРВОНАЧАЛА"
        A[СТАТИС<br/>Бытие-в-себе<br/>Вечное присутствие]
        B[КИНЕСИС<br/>Становление-для-другого<br/>Временной поток]
        C[ТЕЛОС<br/>Смысл-через-себя<br/>Целевая причинность]
    end
    
    subgraph "ДИАДИЧЕСКИЕ СИНТЕЗЫ"
        D[Статис + Кинесис =<br/>СУБСТАНЦИЯ<br/>Изменяющееся постоянство]
        E[Кинесис + Телос =<br/>ЭВОЛЮЦИЯ<br/>Направленное развитие]
        F[Статис + Телос =<br/>ИДЕЯ<br/>Вечная форма]
    end
    
    subgraph "ТРИАДИЧЕСКИЙ СИНТЕЗ"
        G[КОСМОС<br/>Единство трёх начал<br/>в мировом порядке]
    end
    
    A -.-> D
    B -.-> D
    B -.-> E
    C -.-> E
    A -.-> F
    C -.-> F
    
    D --> G
    E --> G
    F --> G
    
    style A fill:#ff6b6b,stroke:#333,stroke-width:2px
    style B fill:#4ecdc4,stroke:#333,stroke-width:2px
    style C fill:#ffe66d,stroke:#333,stroke-width:2px
    style G fill:#95e1d3,stroke:#333,stroke-width:3px