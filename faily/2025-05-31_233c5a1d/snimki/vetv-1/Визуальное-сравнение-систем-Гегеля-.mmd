graph TB
    subgraph "СИСТЕМА ГЕГЕЛЯ"
        A[Абсолютный Дух] --> B[В-себе-бытие<br/>ТЕЗИС]
        B --> C[Для-себя-бытие<br/>АНТИТЕЗИС]
        C --> D[В-себе-и-для-себя-бытие<br/>СИНТЕЗ]
        D --> E[Новый тезис...]
        E -.-> F[∞]
        
        style A fill:#ff9999,stroke:#333,stroke-width:3px
        
        G[Всё есть моменты<br/>единого развития]
    end
    
    subgraph "ТРИАЛИСТИЧЕСКАЯ СИСТЕМА"
        H[СТАТИС<br/>Вечное] 
        I[КИНЕСИС<br/>Становление]
        J[ТЕЛОС<br/>Смысл]
        
        H <--> I
        I <--> J
        J <--> H
        
        H & I & J --> K[КОСМОС<br/>Динамическое единство]
        
        style H fill:#ff6b6b,stroke:#333,stroke-width:2px
        style I fill:#4ecdc4,stroke:#333,stroke-width:2px
        style J fill:#ffe66d,stroke:#333,stroke-width:2px
        style K fill:#95e1d3,stroke:#333,stroke-width:3px
        
        L[Три независимых<br/>сосуществующих начала]
    end
    
    subgraph "КЛЮЧЕВОЕ РАЗЛИЧИЕ"
        M[Гегель: ВРЕМЕННАЯ<br/>последовательность<br/>моментов единого]
        N[Триализм: ВЕЧНОЕ<br/>сосуществование<br/>независимых начал]
        
        M -.->|редукция| O[Монизм процесса]
        N -.->|сохранение| P[Плюрализм бытия]
    end