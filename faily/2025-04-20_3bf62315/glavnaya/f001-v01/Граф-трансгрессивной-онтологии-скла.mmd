    classDef экзистенциальная fill:#b5ead7,stroke:#333,stroke-width:1px;
    classDef языковая fill:#c7ceea,stroke:#333,stroke-width:1px;
    classDef временная fill:#ffdac1,stroke:#333,stroke-width:1px;
    classDef сакральная fill:#ff9aa2,stroke:#333,stroke-width:1px;
    classDef центральная fill:#333333,color:#ffffff,stroke:#ff5555,stroke-width:2px;
    
    %% Применение стилей
    class Ничто,Событие,Складка,Виртуальное,Актуальное,Различие,Повторение,След,Сингулярность,Хаос,Интенсивность,Контингентность онтологическая;
    class Истина,Интерпретация,Горизонт эпистемическая;
    class Тревога,Свобода,Бессознательное,Идентичность экзистенциальная;
    class Метафора,Перформатив языковая;
    class Время временная;
    class Священное,Трансцендентное,Имманентное сакральная;
    class ТрансгрессивнаяОнтология центральная;
