    Знание(["Знание"])
    Действие(["Действие"])
    
    %% Пересмотренные связи для устранения противоречий
    Бытие -->|"Конституирующая"| Становление
    Становление -->|"Эмерджентная"| Событие
    Событие -->|"Конституирующая"| Время
    
    Бытие -->|"Метафорическая"| Складка
    Складка -->|"Конституирующая"| Бессознательное
    
    Интерпретация -->|"Герменевтическая"| Истина
    Истина -->|"Репрезентационная"| Метафора
    
    %% Интеграция Актуального-Виртуального-Священного в общий граф
    Актуальное -->|"Симулятивная"| Виртуальное
    Виртуальное -->|"Репрезентационная"| Священное
    Актуальное -->|"Феноменологическая"| Бытие
    Священное -->|"Дополнение"| Трансцендентное
    Виртуальное -->|"Резонансная"| Событие
    
    Опыт -->|"Конституирующая"| Интерпретация
    Интерпретация -->|"Эпистемическая"| Горизонт
    Горизонт -->|"Дополнение"| Опыт
    
    Событие -->|"Конституирующая"| Тревога
    Тревога -->|"Резонансная"| Различие
    
    Повторение -->|"Телеологическая"| Различие
    Повторение -->|"Конституирующая"| След
    След -->|"Дополнение"| Идентичность
    
    Необходимость -->|"Диалектическое противоречие"| Контингентность
    Необходимость -->|"Дополнение"| Свобода
    
    Событие -->|"Трансгрессивная"| Перформатив
    Перформатив -->|"Конституирующая"| Актуальное
    
    Имманентное -->|"Феноменологическая"| Трансцендентное
    Трансцендентное -->|"Иерархическая"| Сингулярность
    
    Структура -->|"Конституирующая"| Субъект
    Субъект -->|"Эпистемическая"| Знание
    Знание -->|"Герменевтическая"| Истина
    
    Бессознательное -->|"Конституирующая"| Желание
    Желание -->|"Телеологическая"| Действие
    Действие -->|"Конституирующая"| Свобода
    
    Свобода -->|"Феноменологическая"| Субъект
    
    Пространство -->|"Дополнение"| Время
    Время -->|"Конституирующая"| Опыт
    
    Бытие -->|"Феноменологическая"| Сингулярность
    Сингулярность -->|"Эмерджентная"| Интенсивность
    Интенсивность -->|"Резонансная"| Событие
    
    %% Стилизация графа
    classDef онтологическая fill:#f9d5e5,stroke:#333,stroke-width:1px;
    classDef эпистемическая fill:#eeeeee,stroke:#333,stroke-width:1px;
    classDef экзистенциальная fill:#b5ead7,stroke:#333,stroke-width:1px;
    classDef языковая fill:#c7ceea,stroke:#333,stroke-width:1px;
    classDef временная fill:#ffdac1,stroke:#333,stroke-width:1px;
    classDef сакральная fill:#ff9aa2,stroke:#333,stroke-width:1px;
    classDef деятельности fill:#a2d2ff,stroke:#333,stroke-width:1px;
    
    %% Применение стилей
    class Бытие,Становление,Событие,Складка,Виртуальное,Актуальное,Различие,Повторение,След,Сингулярность,Интенсивность,Контингентность,Необходимость онтологическая;
    class Истина,Интерпретация,Горизонт,Знание,Опыт эпистемическая;
    class Тревога,Свобода,Бессознательное,Идентичность,Желание,Субъект экзистенциальная;
    class Метафора,Перформатив языковая;
    class Время,Пространство временная;
    class Священное,Трансцендентное,Имманентное сакральная;
    class Действие,Структура деятельности;
