flowchart TD
    A[Означающая цепь] --> B[S1 → S2 → S3...]
    A --> C[Автономия означающего]
    A --> D[Субъект как эффект]
    
    subgraph "Диалектика означающего"
        E[Означающее S1\nгосподское означающее] --> F[Означающее S2\nзнание]
        F --> G[Субъект $\nрасщепленный]
        G --> H[Объект а\nостаток]
        H -.->|Повторение| E
    end
    
    subgraph "Четыре дискурса"
        I[Дискурс господина] --> J[Дискурс университета]
        J --> K[Дискурс истерика]
        K --> L[Дискурс аналитика]
        L -.->|Циклическая смена| I
    end
    
    subgraph "Логика означающего"
        M[Метафора:\nЗамещение] --> N[Отцовская метафора]
        N --> O[Симптом]
        O --> P[Метонимия:\nСмещение]
        P --> Q[Желание]
        Q -.-> M
    end
    
    B -.-> E
    C -.-> M
    D -.-> G
    
    R[Ретроактивность] --> S[Nachträglichkeit\nпоследействие]
    S --> T[Point de capiton\nточка пристежки]
    T --> U[Фиксация смысла]
    U --> V[Временная остановка\nскольжения]
    V -.-> R
    
    F -.-> J
    G -.-> K
    H -.-> L
    E -.-> I
    
    W[Символический долг] --> X[Речь полная]
    X --> Y[Речь пустая]
    Y --> Z[Бытие-к-смерти]
    Z -.-> W
    
    O -.-> W
    Q -.-> Y
    
