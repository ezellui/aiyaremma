flowchart TD
    A[Объект а как\nапофатическое ядро] --> B[Объект-причина\nжелания]
    A --> C[Остаток операции\nозначивания]
    A --> D[Плюс-наслаждение]
    
    subgraph "Диалектика желания"
        E[Нужда\nbesoin] -->|Артикуляция в языке| F[Требование\ndemande]
        F -->|Остаток| G[Желание\ndésir]
        G -->|Метонимическое скольжение| H[Объект а]
        H -->|Фантазматическая поддержка| I[Субъект $]
        I -.->|Нехватка-в-бытии| E
    end
    
    subgraph "Апофатическое именование"
        J[Катафатическое\nимя] -->|Самоотрицание| K[Апофатический\nмомент]
        K -->|Травматическая встреча| L[Реальное имени]
        L -->|Символизация невозможного| M[Новое имя]
        M -.->|Диалектический возврат| J
    end
    
    subgraph "Модусы объекта а"
        N[Оральный объект:\nгрудь] --> O[Анальный объект:\nэкскременты]
        O --> P[Фаллический объект:\nфаллос]
        P --> Q[Скопический объект:\nвзгляд]
        Q --> R[Инвокативный объект:\nголос]
        R -.-> N
    end
    
    B -.-> G
    C -.-> K
    D -.-> H
    
    S[Энергема имени] --> T[Jouissance]
    T --> U[Избыток над\nпринципом удовольствия]
    U --> V[Травматическое\nядро субъекта]
    V -.-> S
    
    H -.-> L
    H -.-> P
    K -.-> V
    
    W[Невыразимое как\nусловие выражения] --> X[Пустота в центре\nсимволического]
    X --> Y[Экс-тимность\nВнешнее внутреннее]
    Y --> Z[Топологическая\nструктура желания]
    Z -.-> W
    
