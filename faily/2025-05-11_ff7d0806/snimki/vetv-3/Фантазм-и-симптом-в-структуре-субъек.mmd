graph TD
    A[Фантазм $◊a] --> B[Субъект в отношении\nк объекту желания]
    A --> C[Защита от Реального]
    A --> D[Рамка реальности]
    
    subgraph "Структура фантазма"
        E[Расщепленный субъект $] --> F[Ромб ◊\nотношение]
        F --> G[Объект а]
        G --> H[Сценарий желания]
        H --> I[Фиксация jouissance]
        I -.->|Навязчивое повторение| E
    end
    
    subgraph "Диалектика симптома"
        J[Вытесненное] --> K[Возвращение\nвытесненного]
        K --> L[Компромиссное\nобразование]
        L --> M[Зашифрованное\nпослание]
        M --> N[Jouissance симптома]
        N -.->|Сопротивление излечению| J
    end
    
    subgraph "Клинические структуры"
        O[Невроз] --> P[Истерия:\nжелание Другого]
        P --> Q[Обсессивный невроз:\nжелание невозможного]
        Q --> R[Фобия:\nизбегание желания]
        O --> S[Психоз:\nотвержение Имени-Отца]
        O --> T[Перверсия:\nотрицание кастрации]
    end
    
    B -.-> E
    C -.-> H
    D -.-> I
    
    U[Формула фантазма] --> V[Мифологическая\nсцена происхождения]
    V --> W[Первофантазм]
    W --> X[Семейный роман]
    X --> Y[Личный миф]
    Y -.-> U
    
    H -.-> V
    M -.-> Y
    P -.-> E
    Q -.-> E
    R -.-> E
    
    Z[Синтом] --> AA[Четвертое кольцо]
    AA --> AB[Стабилизация\nструктуры]
    AB --> AC[Имя собственное]
    AC --> AD[Сингулярное решение]
    AD -.-> Z
    
    style A fill:#f9d5e5,stroke:#333,stroke-width:3px
    style E fill:#d5e5f9,stroke:#333,stroke-width:2px
    style J fill:#e5f9d5,stroke:#333,stroke-width:2px
    style O fill:#f9e5d5,stroke:#333,stroke-width:2px
    style U fill:#e5d5f9,stroke:#333,stroke-width:2px
    style Z fill:#d5f9e5,stroke:#333,stroke-width:2px