graph TD
    A[Субъект как\nборромеевский узел] --> B[Воображаемое]
    A --> C[Символическое]
    A --> D[Реальное]
    
    subgraph "Воображаемое регистр"
        E[Зеркальный образ] --> F[Идеальное я\nMoi]
        F --> G[Нарциссическая\nидентификация]
        G --> H[Агрессивность\nсоперничества]
        H --> I[Воображаемая\nполнота]
        I -.->|Иллюзорное единство| E
    end
    
    subgraph "Символическое регистр"
        J[Означающее S1] --> K[Означающее S2]
        K --> L[Субъект $\nрасщепленный между\nозначающими]
        L --> M[Большой Другой\nA]
        M --> N[Символический закон]
        N -.->|Цепь означающих| J
    end
    
    subgraph "Реальное регистр"
        O[Травма] --> P[Объект а]
        P --> Q[Jouissance]
        Q --> R[Das Ding\nВещь]
        R --> S[Невозможное]
        S -.->|Повторение| O
    end
    
    B -.-> E
    C -.-> J
    D -.-> O
    
    T[Точка пристежки\npoint de capiton] --> U[Стабилизация\nсмысла]
    U --> V[Симптом как\nчетвертое кольцо]
    V --> W[Синтом]
    W -.-> T
    
    L --> T
    P --> T
    G --> T
    
    X[Нехватка в\nВоображаемом:\nфрустрация] --> Y[Нехватка в\nСимволическом:\nкастрация]
    Y --> Z[Нехватка в\nРеальном:\nлишение]
    Z -.-> X
    
    style A fill:#f9d5e5,stroke:#333,stroke-width:3px
    style B fill:#ffe5d5,stroke:#333,stroke-width:2px
    style C fill:#d5ffe5,stroke:#333,stroke-width:2px
    style D fill:#ffd5e5,stroke:#333,stroke-width:2px
    style T fill:#e5e5ff,stroke:#333,stroke-width:2px
    style V fill:#ffe5e5,stroke:#333,stroke-width:2px