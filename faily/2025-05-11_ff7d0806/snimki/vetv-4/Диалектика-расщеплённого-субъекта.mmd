graph TB
    A[Расщеплённый субъект\n$] --> B[Субъект\nвысказывания]
    A --> C[Субъект акта\nвысказывания]
    
    subgraph "Структура расщепления"
        D[Je идеальное] -->|Отчуждение| E[Moi воображаемое]
        E -->|Символизация| F[Субъект означающего]
        F -->|Конфронтация с Реальным| G[Опустошённый субъект]
        G -->|Идентификация| H[Новое Je]
        H -.->|Повторение| D
    end
    
    subgraph "Диалектические моменты"
        I[Тезис:\nИллюзия единства] --> J[Антитезис:\nОпыт расщепления]
        J --> K[Псевдо-синтез:\nСимптом]
        K --> L[Истина симптома:\nСтруктура желания]
        L -.->|Не снятие, а возврат| I
    end
    
    subgraph "Модусы субъективации"
        M[Отчуждение\nв языке] --> N[Сепарация\nот Другого]
        N --> O[Идентификация\nс означающим]
        O --> P[Дезидентификация\nчерез объект а]
        P --> Q[Акт\nсубъективации]
        Q -.-> M
    end
    
    B -.-> D
    B -.-> I
    C -.-> G
    C -.-> L
    
    R[Граф желания] --> S[Элементарная\nячейка]
    S --> T[Полный\nграф]
    
    S --> S1[Потребность] & S2[Требование] & S3[Желание]
    T --> T1[Фантазм] & T2[Влечение] & T3[Кастрация]
    
    S3 --> A
    T1 --> A
    
    U[Vel отчуждения:\nБытие или смысл] --> A
    V[Апофанзис субъекта:\nИсчезновение/явление] --> A
    
    style A fill:#f9d5e5,stroke:#333,stroke-width:3px
    style D fill:#99ff99,stroke:#333,stroke-width:2px
    style G fill:#ff9999,stroke:#333,stroke-width:2px
    style I fill:#99ccff,stroke:#333,stroke-width:2px
    style M fill:#ffcc99,stroke:#333,stroke-width:2px
    style R fill:#cc99ff,stroke:#333,stroke-width:2px
    style U fill:#ccffcc,stroke:#333,stroke-width:2px
