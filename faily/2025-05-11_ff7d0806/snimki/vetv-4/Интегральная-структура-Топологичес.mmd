graph TD
    A[Топологическая диалектика\nязыкового желания] --> B[Онтология]
    A --> C[Эпистемология]
    A --> D[Этика]
    A --> E[Клиника]
    
    subgraph "Онтологические основания"
        B --> F[Бытие как\nтопологическое пространство]
        F --> G[Das Ding как\nцентральная пустота]
        G --> H[Борромеев узел\nRSI]
        H --> I[Субъект как\nэффект структуры]
    end
    
    subgraph "Эпистемологические следствия"
        C --> J[Знание как\nэффект означающего]
        J --> K[Истина как\nструктура вымысла]
        K --> L[Расщепление\nsavoir/savoir insu]
        L --> M[Материальность\nозначающего]
    end
    
    subgraph "Этические импликации"
        D --> N[Не уступать\nв своём желании]
        N --> O[Этика\nРеального]
        O --> P[Акт как\nреорганизация структуры]
        P --> Q[Ответственность\nза бессознательное]
    end
    
    subgraph "Клинические структуры"
        E --> R[Невроз]
        E --> S[Психоз]
        E --> T[Перверсия]
        R & S & T --> U[Отношение к\nязыку и желанию]
    end
    
    subgraph "Центральные концепты"
        V[Имя как\nборромеев узел] --> W[Миф как\nфундаментальная фантазия]
        W --> X[Расщеплённый\nсубъект]
        X --> Y[Объект а]
        Y --> Z[Большой Другой]
        Z --> AA[Jouissance]
        AA --> AB[Четыре дискурса]
        AB --> AC[Топологические\nфигуры]
    end
    
    A --> V
    
    AD[Диалектика без\nсинтеза] --> AE[Возвращение к\nисходной травме]
    AE --> AF[Повторение как\nструктурная необходимость]
    AF --> AG[Реальное как\nневозможное]
    
    AD --> A
    
    AH[Практика анализа] --> AI[Трансфер]
    AI --> AJ[Интерпретация]
    AJ --> AK[Конец анализа]
    AK --> AL[Проход]
    
    AH --> A
    
    style A fill:#f9d5e5,stroke:#333,stroke-width:4px
    style B fill:#99ccff,stroke:#333,stroke-width:2px
    style C fill:#99ff99,stroke:#333,stroke-width:2px
    style D fill:#ffcc99,stroke:#333,stroke-width:2px
    style E fill:#ff9999,stroke:#333,stroke-width:2px
