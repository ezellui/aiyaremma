graph TD
    A[Большой Другой\nA] --> B[Символический\nпорядок]
    A --> C[Сокровищница\nозначающих]
    A --> D[Место\nкода]
    
    subgraph "Структура Большого Другого"
        E[Место речи] --> F[Гарант\nистины]
        F --> G[Адресат\nтребования]
        G --> H[Свидетель\nпакта]
        H --> I[Локус\nзакона]
        I -.-> E
    end
    
    subgraph "Парадоксы Другого"
        J[Другой\nне существует] --> K[Нехватка\nв Другом]
        K --> L[Другой\nДругого]
        L --> M[Несостоятельность\nсимволического]
        M --> N[Возвращение\nРеального]
        N -.-> J
    end
    
    subgraph "Отношения с Другим"
        O[Che vuoi?\nЧего ты хочешь?] --> P[Загадка\nжелания Другого]
        P --> Q[Фантазматический\nответ]
        Q --> R[Симптоматическое\nрешение]
        R --> S[Этическая\nпозиция]
        S -.-> O
    end
    
    B -.-> E
    C -.-> F
    D -.-> I
    
    A --> J
    
    T[Языковая игра] --> U[Правило как\nтребование Другого]
    U --> V[Следование как\nподчинение]
    V --> W[Интерпретация как\nсубверсия]
    W -.-> T
    
    T -.-> B
    U -.-> G
    V -.-> H
    W -.-> K
    
    X[Имя-Отца] --> Y[Метафора\nОтца]
    Y --> Z[Точка пристёжки\nсмысла]
    Z --> A
    
    AA[Материнское желание] -->|Отцовский запрет| AB[Символическая\nкастрация]
    AB --> A
    
    style A fill:#f9d5e5,stroke:#333,stroke-width:3px
