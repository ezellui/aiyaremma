graph TD
    A[Имя как\nтопологический узел] --> B[Реальное имени]
    A --> C[Символическое имени]
    A --> D[Воображаемое имени]
    
    subgraph "Реальное измерение"
        B --> E[Травматическая\nпустота]
        E --> F[Невозможность\nполного схватывания]
        F --> G[Апофатическое\nядро]
        G --> H[Причина\nозначивания]
        H -.->|Возвращение| E
    end
    
    subgraph "Символическое измерение"
        C --> I[Дифференциальная\nсистема]
        I --> J[Означающая\nцепь]
        J --> K[Метонимическое\nскольжение]
        K --> L[Метафорическая\nконденсация]
        L -.->|Циркуляция| I
    end
    
    subgraph "Воображаемое измерение"
        D --> M[Иллюзия\nполноты]
        M --> N[Зеркальная\nидентификация]
        N --> O[Нарциссический\nобраз]
        O --> P[Отчуждение\nв образе]
        P -.->|Повторение| M
    end
    
    B & C & D -->|Борромеев узел| Q[Неразрывное\nпереплетение]
    
    R[S1: Господское\nозначающее] --> S[S2: Знание]
    S --> T[$: Расщеплённый\nсубъект]
    T --> U[a: Объект-причина\nжелания]
    U -.-> R
    
    R -.-> C
    T -.-> B
    U -.-> D
    
    V[Имя-Отца] --> W[Точка пристёжки]
    W --> Q
    
    style A fill:#f9d5e5,stroke:#333,stroke-width:3px
    style B fill:#ff9999,stroke:#333,stroke-width:2px
    style C fill:#99ccff,stroke:#333,stroke-width:2px
    style D fill:#99ff99,stroke:#333,stroke-width:2px
    style Q fill:#ffcc99,stroke:#333,stroke-width:3px
    style V fill:#cc99ff,stroke:#333,stroke-width:2px
