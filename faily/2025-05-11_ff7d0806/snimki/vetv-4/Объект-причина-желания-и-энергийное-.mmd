flowchart TD
    A[Объект малое а] --> B[Причина\nжелания]
    A --> C[Избыток\njouissance]
    A --> D[Остаток\nсимволизации]
    
    subgraph "Структура объекта а"
        E[Объект-взгляд] --> E1[Невидимая точка\nвзгляда Другого]
        F[Объект-голос] --> F1[Безмолвный\nзов Другого]
        G[Объект-грудь] --> G1[Утраченный объект\nоральности]
        H[Объект-фекалии] --> H1[Отделяемая часть\nтела]
        I[Объект-ничто] --> I1[Фаллос как\nотсутствие]
        
        E & F & G & H & I --> J[Парциальные\nобъекты]
    end
    
    subgraph "Циркуляция объекта а"
        K[Возникновение\nв разрыве] --> L[Циркуляция\nв фантазме]
        L --> M[Фиксация\nв симптоме]
        M --> N[Извлечение\nв анализе]
        N --> O[Новая\nсублимация]
        O -.-> K
    end
    
    subgraph "Энергийное измерение"
        P[Либидинальная\nэнергия] --> Q[Инвестиция\nв означающее]
        Q --> R[Возврат\njouissance]
        R --> S[Энтропия\nжелания]
        S --> T[Повторение\nвлечения]
        T -.-> P
    end
    
    A --> J
    B -.-> K
    C -.-> P
    D -.-> Q
    
    U[Имя как контур\nвокруг пустоты] --> V[Означающее\nкак граница]
    V --> W[Объект а\nкак ядро]
    W --> X[Топологическая\nструктура]
    
    U --> A
    
    Y[Agalma:\nСкрытое сокровище] --> Z[Причина\nпереноса]
    Z --> AA[Объект\nлюбви]
    AA --> A
    
    AB[Plus-de-jouir:\nПрибавочное наслаждение] --> A
    
    style A fill:#f9d5e5,stroke:#333,stroke-width:3px
    style E fill:#99ccff,stroke:#333,stroke-width:2px
    style F fill:#99ff99,stroke:#333,stroke-width:2px
    style G fill:#ffcc99,stroke:#333,stroke-width:2px
    style H fill:#ff9999,stroke:#333,stroke-width:2px
    style I fill:#cc99ff,stroke:#333,stroke-width:2px
    style K fill:#ccffcc,stroke:#333,stroke-width:2px
    style P fill:#ffcccc,stroke:#333,stroke-width:2px
    style U fill:#ccccff,stroke:#333,stroke-width:2px
    style Y fill:#ffffcc,stroke:#333,stroke-width:2px
