flowchart TD
    A[Миф как\nфундаментальная фантазия] --> B[Структура\n$◊a]
    A --> C[Экран перед\nРеальным]
    A --> D[Организация\nжелания]
    
    subgraph "Фантазматическая структура"
        E[Расщеплённый субъект\n$] --> F[Отношение к\nобъекту а]
        F --> G[Попытка заполнить\nнехватку в Другом]
        G --> H[Иллюзия возможности\nполного наслаждения]
        H --> I[Защита от\nтравматического Реального]
        I -.->|Повторение| E
    end
    
    subgraph "Мифологические операции"
        J[Сгущение\nсимволического] --> K[Смещение\nтравмы]
        K --> L[Вторичная\nобработка]
        L --> M[Нарративная\nкогерентность]
        M --> N[Идеологическая\nфункция]
        N -.-> J
    end
    
    subgraph "Типы мифов"
        O[Невротический миф:\nМиф об утраченной\nполноте] --> P[Истерический:\nНедостижимость\nидеала]
        O --> Q[Обсессивный:\nОтсрочка\nжелания]
        
        R[Психотический миф:\nБредовая\nметафора] --> S[Параноидный:\nВсё имеет\nсмысл]
        R --> T[Шизофренический:\nРаспад\nозначающей цепи]
        
        U[Перверсивный миф:\nОтрицание\nкастрации] --> V[Фетишистский:\nЗамещение\nнехватки]
        U --> W[Садистический:\nИнструментализация\nДругого]
    end
    
    B -.-> E
    C -.-> I
    D -.-> G
    
    O & R & U --> X[Клинические\nвариации мифа]
    X --> A
    
    Y[Социальный миф] --> Z[Идеология как\nфантазия]
    Z --> AA[Коллективное\njouissance]
    AA -.-> Y
    
    Y --> A
    
    style A fill:#f9d5e5,stroke:#333,stroke-width:3px
    style E fill:#99ccff,stroke:#333,stroke-width:2px
    style J fill:#99ff99,stroke:#333,stroke-width:2px
    style O fill:#ffcc99,stroke:#333,stroke-width:2px
    style R fill:#ff9999,stroke:#333,stroke-width:2px
    style U fill:#cc99ff,stroke:#333,stroke-width:2px
    style Y fill:#ccffcc,stroke:#333,stroke-width:2px
