flowchart TD
    A[Топологические\nфигуры субъективности] --> B[Лента\nМёбиуса]
    A --> C[Бутылка\nКляйна]
    A --> D[Тор]
    A --> E[Кросс-кэп]
    
    subgraph "Лента Мёбиуса"
        B --> F[Единая поверхность\nбез изнанки]
        F --> G[Субъект/Другой\nкак континуум]
        G --> H[Внутреннее/внешнее\nнеразличимы]
        H --> I[Бессознательное -\nдискурс Другого]
    end
    
    subgraph "Бутылка Кляйна"
        C --> J[Самопроникновение\nповерхности]
        J --> K[Содержащее становится\nсодержимым]
        K --> L[Структура\nфантазма]
        L --> M[Субъект содержит\nсвой объект]
    end
    
    subgraph "Тор"
        D --> N[Два типа\nпустоты]
        N --> O[Центральная пустота:\nобъект а]
        O --> P[Периферическая пустота:\nсубъект]
        P --> Q[Циркуляция\nжелания]
    end
    
    subgraph "Кросс-кэп"
        E --> R[Проективная\nплоскость]
        R --> S[Точка\nсамопересечения]
        S --> T[Место\nсимптома]
        T --> U[Узел\njouissance]
    end
    
    subgraph "Борромеев узел"
        V[Три кольца\nRSI] --> W[Взаимное\nсцепление]
        W --> X[Разрыв одного\nосвобождает все]
        X --> Y[Структурная\nвзаимозависимость]
        Y --> Z[Топология\nпсихической реальности]
    end
    
    A --> V
    
    AA[Топологическое время] --> AB[Логическое время\nсубъекта]
    AB --> AC[Момент видения]
    AC --> AD[Время понимания]
    AD --> AE[Момент заключения]
    AE -.-> AC
    
    AA --> A
    
    AF[Cut/сечение] --> AG[Интерпретация как\nтопологическая операция]
    AG --> AH[Преобразование\nструктуры]
    AH --> AI[Изменение режима\njouissance]
    
    AF --> A
    
    style A fill:#f9d5e5,stroke:#333,stroke-width:3px
    style B fill:#99ccff,stroke:#333,stroke-width:2px
    style C fill:#99ff99,stroke:#333,stroke-width:2px
    style D fill:#ffcc99,stroke:#333,stroke-width:2px
    style E fill:#ff9999,stroke:#333,stroke-width:2px
    style V fill:#cc99ff,stroke:#333,stroke-width:3px
    style AA fill:#ccffcc,stroke:#333,stroke-width:2px
    style AF fill:#ffcccc,stroke:#333,stroke-width:2px
