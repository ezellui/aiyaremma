graph TD
    A[Означающее-в-становлении-желания] --> B[Топологический узел\nтрёх измерений]
    
    subgraph "Три измерения означающего"
        C[Энергийное самораскрытие\nимени] --> D[Скольжение означающих\nв цепи]
        D --> E[Желание как\nонтологическая сила]
        E --> C
    end
    
    subgraph "Диалектика становления"
        F[Момент самопорождения] -->|Невозможность| G[Разрыв в символическом]
        G -->|Желание| H[Попытка восполнения]
        H -->|Избыток| I[Новое означающее]
        I -->|Нехватка| J[Скольжение смысла]
        J -.->|Возвращение| F
    end
    
    subgraph "Топологическая структура"
        K[Точка невозможного] --> L[Петля самореференции]
        L --> M[Искривление смыслового\nпространства]
        M --> N[Узел желания\nи языка]
        N --> O[Мёбиусоподобная\nструктура]
        O -.-> K
    end
    
    B --> C
    B --> F
    B --> K
    
    P[Языковая игра] -.-> Q[Лакановское означающее]
    Q -.-> R[Лосевское имя]
    R -.-> P
    
    P --> S[Синтетическое единство\nв топологическом узле]
    Q --> S
    R --> S
    S --> A
    
    style A fill:#f9d5e5,stroke:#333,stroke-width:3px
    style B fill:#e5f9d5,stroke:#333,stroke-width:2px
    style F fill:#d5e5f9,stroke:#333,stroke-width:2px
    style K fill:#f9e5d5,stroke:#333,stroke-width:2px
    style S fill:#ffffcc,stroke:#333,stroke-width:3px