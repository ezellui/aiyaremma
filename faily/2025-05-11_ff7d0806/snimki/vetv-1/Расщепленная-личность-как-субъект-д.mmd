graph TD
    A[Расщепленная личность] --> B[Субъект диалектического\nжелания]
    
    subgraph "Структура расщепления"
        C[Я идеальное\nвоображаемое] --> D[Субъект высказывания\nсимволическое]
        D --> E[Субъект желания\nреальное]
        E -->|Несовпадение| C
    end
    
    subgraph "Диалектика самопорождения"
        F[Первичное отчуждение:\nстадия зеркала] --> G[Вторичное отчуждение:\nвхождение в язык]
        G --> H[Расщепление как\nусловие субъективации]
        H --> I[Желание как\nдвижущая сила]
        I --> J[Идентификация\nчерез отчуждение]
        J -.-> F
    end
    
    subgraph "Топологические операции субъекта"
        K[Субъект как\nпустое место] --> L[Скольжение по\nцепи означающих]
        L --> M[Ретроактивное\nконституирование]
        M --> N[Переворачивание\nсубъект/объект]
        N --> O[Мёбиусоподобная\nидентичность]
        O -.-> K
    end
    
    B --> C
    B --> F
    B --> K
    
    P[Лосевская личность] -.-> Q[Лакановский $]
    Q -.-> R[Гегелевский субъект]
    R -.-> P
    
    P --> S[Синтез в структуре\nрасщепленной личности]
    Q --> S
    R --> S
    S --> A
    
    T[Конкретное единство] --> U[Внутреннее разделение]
    U --> V[Диалектическое\nсамодвижение]
    V --> W[Топологическая\nидентичность]
    W -.-> T
    
    style A fill:#f9d5e5,stroke:#333,stroke-width:3px
    style B fill:#e5f9d5,stroke:#333,stroke-width:2px
    style C fill:#d5e5f9,stroke:#333,stroke-width:2px
    style F fill:#e5f9d5,stroke:#333,stroke-width:2px
    style K fill:#f9e5d5,stroke:#333,stroke-width:2px
    style S fill:#ffffcc,stroke:#333,stroke-width:3px