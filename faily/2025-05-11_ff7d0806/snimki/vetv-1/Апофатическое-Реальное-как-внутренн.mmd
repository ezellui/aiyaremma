flowchart TD
    A[Апофатическое Реальное] --> B[Внутренняя граница\nязыка]
    
    subgraph "Диалектика присутствия-отсутствия"
        C[Невыразимое как\nусловие выражения] -->|Парадокс| D[Присутствие через\nотсутствие]
        D -->|Негативность| E[Конститутивная\nнехватка]
        E -->|Возвращение| F[Травматическое\nядро]
        F -->|Символизация| G[Остаток\nнесимволизируемого]
        G -.->|Повторение| C
    end
    
    subgraph "Топологическая структура"
        H[Дыра в\nсимволическом] --> I[Экстимность:\nвнешнее внутри]
        I --> J[Точка капитона:\nостановка скольжения]
        J --> K[Узел симптома:\nспособ обхода дыры]
        K --> L[Синтом как\nизобретение]
        L -.-> H
    end
    
    subgraph "Регистры апофатики"
        M[Реальное реального:\nабсолютная невозможность] --> N[Реальное символического:\nлогическая противоречивость]
        N --> O[Реальное воображаемого:\nтревожащая странность]
        O --> P[Узловая апофатика:\nточка схождения]
        P -.-> M
    end
    
    B --> C
    B --> H
    B --> M
    
    Q[Лосевская апофатика] -.-> R[Лакановское Реальное]
    R -.-> S[Витгенштейновское\nневыразимое]
    S -.-> Q
    
    Q --> T[Синтез в структуре\nапофатического Реального]
    R --> T
    S --> T
    T --> A
    
    style A fill:#f9d5e5,stroke:#333,stroke-width:3px
    style B fill:#e5f9d5,stroke:#333,stroke-width:2px
    style C fill:#d5e5f9,stroke:#333,stroke-width:2px
    style H fill:#e5f9d5,stroke:#333,stroke-width:2px
    style M fill:#f9e5d5,stroke:#333,stroke-width:2px
    style T fill:#ffffcc,stroke:#333,stroke-width:3px