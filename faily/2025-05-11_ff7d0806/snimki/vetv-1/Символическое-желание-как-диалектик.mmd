graph TB
    A[Символическое желание] --> B[Диалектика нехватки\nи избытка]
    
    subgraph "Циклическая структура желания"
        C[Фундаментальная\nнехватка] -->|Попытка восполнения| D[Акт выражения]
        D -->|Порождение| E[Избыток смысла]
        E -->|Обращение| F[Новая нехватка]
        F -->|Смещение| G[Метонимия желания]
        G -.->|Возвращение| C
    end
    
    subgraph "Онтологические уровни"
        H[Нехватка-в-бытии] --> I[Символическая\nкастрация]
        I --> J[Объект причины\nжелания]
        J --> K[Фантазм как\nрамка реальности]
        K --> L[Симптом как\nспособ jouissance]
        L -.-> H
    end
    
    subgraph "Топологические фигуры"
        M[Тор желания:\nПеренос по поверхности] --> N[Крест-накрест:\nМетафора и метонимия]
        N --> O[Бутылка Кляйна:\nВнутреннее/внешнее]
        O --> P[Проективная плоскость:\nСубъект/Другой]
        P -.-> M
    end
    
    B --> C
    B --> H
    B --> M
    
    Q[Лосевский символ] -.-> R[Объект малое а]
    R -.-> S[Диалектическое\nвыражение]
    S -.-> Q
    
    Q --> T[Синтез в структуре\nсимволического желания]
    R --> T
    S --> T
    T --> A
    
    style A fill:#f9d5e5,stroke:#333,stroke-width:3px
    style B fill:#e5f9d5,stroke:#333,stroke-width:2px
    style C fill:#d5e5f9,stroke:#333,stroke-width:2px
    style H fill:#e5f9d5,stroke:#333,stroke-width:2px
    style M fill:#f9e5d5,stroke:#333,stroke-width:2px
    style T fill:#ffffcc,stroke:#333,stroke-width:3px