flowchart TD
    A[Мифологема] --> B[Топологический узел\nRSI]
    
    subgraph "Диалектическое порождение регистров"
        C[Реальное] -->|Символизация| D[Символическое]
        D -->|Воображение| E[Воображаемое]
        E -->|Травма встречи| C
    end
    
    subgraph "Процесс завязывания/развязывания"
        F[Устойчивый узел:\nНевроз] --> G[Разрыв узла:\nПсихоз]
        G --> H[Перезавязывание:\nСинтом]
        H --> I[Новая конфигурация:\nСублимация]
        I -.-> F
    end
    
    subgraph "Мифологические операции"
        J[Именование\nнеименуемого] --> K[Нарративизация\nтравмы]
        K --> L[Символизация\nжелания]
        L --> M[Воображаемая\nидентификация]
        M --> N[Встреча с\nРеальным]
        N -.-> J
    end
    
    B --> C
    B --> F
    B --> J
    
    O[Миф как форма жизни] -.-> P[Символический порядок]
    P -.-> Q[Борромеевы кольца]
    Q -.-> O
    
    O --> R[Синтез в\nтопологической структуре]
    P --> R
    Q --> R
    R --> A
    
    S[Форма жизни] --> T[Языковая игра]
    T --> U[Желание Другого]
    U --> V[Мифологическое\nпространство]
    V -.-> S
    
