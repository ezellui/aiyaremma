flowchart TD
    A[Топологическое\nсамосозерцание] --> B[Самосозерцание через\nполе Другого]
    
    subgraph "Структура ленты Мёбиуса"
        C[Внутреннее:\nсубъективность] -->|Непрерывный переход| D[Внешнее:\nинтерсубъективность]
        D -->|Скручивание| E[Другой внутри]
        E -->|Возвращение| F[Я как Другой]
        F -->|Инверсия| G[Другой как Я]
        G -.-> C
    end
    
    subgraph "Диалектика взгляда"
        H[Я вижу себя] --> I[Я вижу себя\nвидящим]
        I --> J[Другой видит\nменя]
        J --> K[Я вижу себя\nглазами Другого]
        K --> L[Взгляд как\nобъект а]
        L -.-> H
    end
    
    subgraph "Эстетические модальности"
        M[Прекрасное:\nвоображаемая полнота] --> N[Возвышенное:\nпредел символизации]
        N --> O[Жуткое:\nвозвращение вытесненного]
        O --> P[Комическое:\nразрыв идентификации]
        P --> Q[Трагическое:\nвстреча с Реальным]
        Q -.-> M
    end
    
    B --> C
    B --> H
    B --> M
    
    R[Эстетическое\nсамосозерцание] -.-> S[Отношение к\nБольшому Другому]
    S -.-> T[Воображаемый\nрегистр]
    T -.-> R
    
    R --> U[Синтез в топологической\nструктуре]
    S --> U
    T --> U
    U --> A
    
    V[Искусство как симптом] --> W[Сублимация желания]
    W --> X[Создание пустоты]
    X --> Y[Обход Реального]
    Y -.-> V
    
    style A fill:#f9d5e5,stroke:#333,stroke-width:3px
    style B fill:#e5f9d5,stroke:#333,stroke-width:2px
    style C fill:#d5e5f9,stroke:#333,stroke-width:2px
    style H fill:#e5f9d5,stroke:#333,stroke-width:2px
    style M fill:#f9e5d5,stroke:#333,stroke-width:2px
    style U fill:#ffffcc,stroke:#333,stroke-width:3px