graph TD
    A[Топологическая диалектика\nжелающего языка] --> B[Топо-онтология]
    
    subgraph "Онтологические уровни"
        C[Узловое бессознательное\nоснование] --> D[Апофатическое Реальное\nграница]
        D --> E[Символическое желание\nдвижение]
        E --> F[Мифологема\nструктура]
        F --> G[Расщепленная личность\nсубъект]
        G --> H[Означающее-в-становлении\nакт]
        H --> I[Топологическое самосозерцание\nзавершение]
        I -.->|Новый цикл| C
    end
    
    subgraph "Топологические фигуры"
        J[Лента Мёбиуса:\nсубъект/Другой] --> K[Тор:\nжелание]
        K --> L[Бутылка Кляйна:\nвнутреннее/внешнее]
        L --> M[Борромеевы кольца:\nRSI]
        M --> N[Проективная плоскость:\nреальность]
        N -.-> J
    end
    
    subgraph "Диалектические моменты"
        O[Тезис:\nязыковая игра] --> P[Антитезис:\nжелание Другого]
        P --> Q[Синтез:\nозначающее-желание]
        Q --> R[Новый тезис:\nмифологема]
        R -.-> O
    end
    
    subgraph "Этико-эстетические измерения"
        S[Ответственное желание] --> T[Топологический жест]
        T --> U[Символическая практика]
        U --> V[Эстетическое созерцание]
        V -.-> S
    end
    
    B --> C
    B --> J
    B --> O
    B --> S
    
    W[Синтез четырех традиций:\nГегель - Витгенштейн -\nЛосев - Лакан] --> A
    A --> X[Радикально новая\nфилософская концепция]
    
    style A fill:#f9d5e5,stroke:#333,stroke-width:3px
    style B fill:#e5f9d5,stroke:#333,stroke-width:3px
    style C fill:#d5e5f9,stroke:#333,stroke-width:2px
    style J fill:#e5f9d5,stroke:#333,stroke-width:2px
    style O fill:#f9e5d5,stroke:#333,stroke-width:2px
    style S fill:#e5d5f9,stroke:#333,stroke-width:2px
    style W fill:#ffffcc,stroke:#333,stroke-width:3px
    style X fill:#ccffcc,stroke:#333,stroke-width:3px