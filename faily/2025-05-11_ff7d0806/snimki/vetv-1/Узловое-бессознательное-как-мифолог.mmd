graph TD
    A[Узловое бессознательное] --> B[Процесс завязывания/развязывания\nсмысловых узлов]
    
    subgraph "Структура бессознательного"
        C[Означающие цепи] --> D[Точки капитона]
        D --> E[Узлы фантазма]
        E --> F[Симптоматические\nобразования]
        F --> G[Возвращение\nвытесненного]
        G -.-> C
    end
    
    subgraph "Мифологические операции"
        H[Первичная\nрепрезентация] --> I[Вторичная\nпереработка]
        I --> J[Сгущение/смещение]
        J --> K[Мифологическая\nнарративизация]
        K --> L[Символическая\nфиксация]
        L -.-> H
    end
    
    subgraph "Топологическая динамика"
        M[Борромеевы узлы:\nRSI] --> N[Развязывание:\nпсихоз]
        N --> O[Перезавязывание:\nсинтом]
        O --> P[Четвертое кольцо:\nимя-отца]
        P --> Q[Новая конфигурация:\nсублимация]
        Q -.-> M
    end
    
    B --> C
    B --> H
    B --> M
    
    R[Бессознательное\nкак язык] -.-> S[Мифологическое\nпространство]
    S -.-> T[Диалектика\nимени]
    T -.-> R
    
    R --> U[Синтез в структуре\nузлового бессознательного]
    S --> U
    T --> U
    U --> A
    
    V[Желание] --> W[Язык]
    W --> X[Бытие]
    X --> V
    
    V --> Y[Неразделимое единство\nв топологическом узле]
    W --> Y
    X --> Y
    Y --> B
    
    style A fill:#f9d5e5,stroke:#333,stroke-width:3px
    style B fill:#e5f9d5,stroke:#333,stroke-width:2px
    style C fill:#d5e5f9,stroke:#333,stroke-width:2px
    style H fill:#e5f9d5,stroke:#333,stroke-width:2px
    style M fill:#f9e5d5,stroke:#333,stroke-width:2px
    style U fill:#ffffcc,stroke:#333,stroke-width:3px
    style Y fill:#ccffcc,stroke:#333,stroke-width:3px