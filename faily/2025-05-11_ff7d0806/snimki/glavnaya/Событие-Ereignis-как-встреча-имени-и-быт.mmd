graph TD
    A[Событие\nEreignis] --> B[Изначальная\nвстреча]
    A --> C[Со-принадлежность\nчеловека и бытия]
    A --> D[Источник всякого\nсмысла]
    
    subgraph "Структура события"
        E[Бытие вверяет\nсебя человеку] --> F[Человек отвечает\nна зов бытия]
        F --> G[Язык как место\nвстречи]
        G --> H[Имя как событие\nистины]
        H --> I[Взаимопринадлежность\nв различии]
        I -.-> E
    end
    
    subgraph "Диалектика события"
        J[Приближение\nбытия] -->|Дарение| K[Принятие\nчеловеком]
        K -->|Ответствование| L[Символическое\nединство]
        L -->|Различие в единстве| M[Новое событие]
        M -.-> J
    end
    
    subgraph "Апофатический момент события"
        N[Бытие ускользает] --> O[След отсутствия]
        O --> P[Утаенность в\nоткрытости]
        P --> Q[Тайна как\nисточник]
        Q --> R[Невыразимое как\nусловие выражения]
        R -.-> N
    end
    
    B -.-> E
    C -.-> I
    D -.-> H
    
    S[Символическая\nдиалектика] --> T[Встреча смысла\nи материи]
    T --> U[Энергийное\nвыражение]
    U --> V[Событийность\nсимвола]
    V -.-> S
    
    S -.-> L
    T -.-> G
    U -.-> H
    V -.-> A
    
    W[Языковая игра] --> X[Правило как\nслед события]
    X --> Y[Употребление как\nповторение события]
    Y --> Z[Форма жизни как\nпространство события]
    Z -.-> W
    
    style A fill:#f9d5e5,stroke:#333,stroke-width:3px
    style E fill:#d5e5f9,stroke:#333,stroke-width:2px
    style J fill:#e5f9d5,stroke:#333,stroke-width:2px
    style N fill:#f9e5d5,stroke:#333,stroke-width:2px
    style S fill:#e5d5f9,stroke:#333,stroke-width:2px
    style W fill:#d5f9e5,stroke:#333,stroke-width:2px