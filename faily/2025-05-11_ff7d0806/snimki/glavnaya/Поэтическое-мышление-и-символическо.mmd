flowchart TD
    A[Поэтическое\nмышление] --> B[Изначальный\nязык]
    A --> C[Событие\nистины]
    A --> D[Учреждение\nмира]
    
    subgraph "Структура поэтического"
        E[Именование\nсвященного] --> F[Основание\nбытия словом]
        F --> G[Раскрытие\nземли]
        G --> H[Спор мира\nи земли]
        H --> I[Истина как\nпроизведение]
        I -.-> E
    end
    
    subgraph "Диалектика художественного символа"
        J[Чувственный\nобраз] -->|Просвечивание| K[Сверхчувственный\nсмысл]
        K -->|Воплощение| L[Символическое\nединство]
        L -->|Событие| M[Эстетическая\nистина]
        M -.-> J
    end
    
    subgraph "Язык как поэзия"
        N[Обыденная речь] --> O[Поэтическое\nслово]
        O --> P[Мыслящее\nсказывание]
        P --> Q[Благодарное\nмышление]
        Q --> R[Gelassenheit\nОтрешенность]
        R -.-> N
    end
    
    B -.-> F
    C -.-> I
    D -.-> G
    
    S[Символическое\nсамосозерцание] --> T[Язык говорит\nсам]
    T --> U[Человек внимает\nязыку]
    U --> V[Со-ответствие\nбытию]
    V -.-> S
    
    S -.-> L
    T -.-> O
    U -.-> Q
    V -.-> A
    
    W[Искусство как\nпривилегированное место] --> X[Храм как\nсобирание мира]
    X --> Y[Поэма как\nучреждение бытия]
    Y --> Z[Мышление как\nпоэзия]
    Z -.-> W
    
