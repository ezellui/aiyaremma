flowchart TD
    A[Экзистенциальная\nапофатика] --> B[Конечность\nDasein]
    A --> C[Онтологическое\nразличие]
    A --> D[След бытия\nв языке]
    
    subgraph "Структура конечности"
        E[Бытие-к-смерти] --> F[Временность]
        F --> G[Историчность]
        G --> H[Фактичность]
        H --> I[Брошенность]
        I -.-> E
    end
    
    subgraph "Апофатические уровни"
        J[Невыразимость\nбытия] --> K[Несказанность\nсущности]
        K --> L[Неисчерпаемость\nсмысла]
        L --> M[Тайна личности]
        M --> N[Молчание как\nисток речи]
        N -.-> J
    end
    
    subgraph "Диалектика выразимого-невыразимого"
        O[Сказанное\nслово] -->|Указывает на| P[Несказанное]
        P -->|Делает возможным| Q[Новое говорение]
        Q -->|Сохраняет| R[Неисчерпаемость]
        R -.-> O
    end
    
    B -.-> E
    C -.-> J
    D -.-> P
    
    S[Языковые патологии] --> T[Онтологические\nпротиворечия]
    T --> U[Необходимое\nнапряжение]
    U --> V[Движущая сила\nязыка]
    V -.-> S
    
    S -.-> H
    T -.-> K
    U -.-> Q
    V -.-> A
    
    W[Ничто как\nгоризонт] --> X[Angst как\nнастроенность]
    X --> Y[Открытость\nбытию]
    Y --> Z[Подлинная речь]
    Z -.-> W
    
    style A fill:#f9d5e5,stroke:#333,stroke-width:3px
    style E fill:#d5e5f9,stroke:#333,stroke-width:2px
    style J fill:#e5f9d5,stroke:#333,stroke-width:2px
    style O fill:#f9e5d5,stroke:#333,stroke-width:2px
    style S fill:#e5d5f9,stroke:#333,stroke-width:2px
    style W fill:#d5f9e5,stroke:#333,stroke-width:2px